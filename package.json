{
  "name": "vendure",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://www.vendure.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/vendurehq/vendure"
  },
  "scripts": {
    "watch": "lerna run watch --parallel",
    "watch:core-common": "lerna run --scope @vendure/common --scope @vendure/core watch --parallel",
    "build:core-common": "lerna run --scope @vendure/common --scope @vendure/core build",
    "lint": "eslint --fix",
    "format": "prettier --write --html-whitespace-sensitivity ignore",
    "docs:generate-typescript-docs": "tsx scripts/docs/generate-typescript-docs.ts",
    "docs:compile-manifest": "bun run docs/scripts/compile-manifest.ts",
    "docs:generate-graphql-docs": "tsx scripts/docs/generate-graphql-docs.ts --api=shop && tsx scripts/docs/generate-graphql-docs.ts --api=admin",
    "docs:build": "bun run docs:generate-typescript-docs && bun run docs:generate-graphql-docs",
    "codegen": "tsc -p scripts/codegen/plugins && tsx scripts/codegen/generate-graphql-types.ts && bun run codegen:gql-tada",
    "codegen:gql-tada": "tsx scripts/codegen/generate-gql-tada-types.ts",
    "version": "bun install && bun run check-imports && bun run --cwd packages/common generate-platform-promotion-snapshot && bun run build && bun run check-core-type-defs && bun run generate-changelog && git add CHANGELOG* && git add */version.ts && git add bun.lock && git add packages/common/src/platform-promotion-snapshot.ts",
    "test": "lerna run test --stream --no-bail",
    "e2e": "lerna run e2e --stream --no-bail",
    "build": "node scripts/tooling/assert-typescript-7.cjs && lerna run build",
    "check-imports": "tsx scripts/check-imports.ts",
    "check-core-type-defs": "tsx scripts/check-core-type-defs.ts",
    "generate-changelog": "tsx scripts/changelogs/generate-changelog.ts",
    "publish-release": "lerna version -m \"chore: Publish %s\" --no-push --force-publish --exact",
    "publish-prerelease": "lerna version -m \"chore: Pre-release %s\" prerelease --exact --no-push --force-publish --preid next --dist-tag next",
    "publish-local": "lerna version --force-publish --no-git-tag-version && cd scripts && ./publish-to-verdaccio.sh",
    "typeorm:use": "node scripts/typeorm/use-version.mjs",
    "typeorm:verify": "node scripts/typeorm/verify.mjs",
    "build:for-tests": "node scripts/typeorm/build-for-tests.mjs",
    "test:db": "node scripts/typeorm/run-db-tests.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.1.0",
    "@commitlint/config-conventional": "^21.2.2",
    "@graphql-codegen/add": "6.0.1",
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-tools/schema": "^10.1.1",
    "@swc/core": "^1.4.6",
    "@types/node": "^20.11.19",
    "@vendure-io/docs-generator": "^0.1.1",
    "concurrently": "^9.2.0",
    "conventional-changelog-core": "^7.0.0",
    "cross-env": "^7.0.3",
    "find": "^0.3.0",
    "gql.tada": "^1.11.4",
    "graphql": "^16.14.2",
    "husky": "^4.3.0",
    "lerna": "^9.0.3",
    "lint-staged": "^10.5.4",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rollup": "^4.18.0",
    "tinybench": "^2.6.0",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "//": "Fix for https://github.com/npm/cli/issues/4828",
  "optionalDependencies": {
    "@nx/nx-darwin-arm64": "17.2.8",
    "@nx/nx-darwin-x64": "17.3.2",
    "@nx/nx-linux-x64-gnu": "17.2.8",
    "@nx/nx-win32-x64-msvc": "17.2.8",
    "@rollup/rollup-linux-x64-gnu": "^4.13.0",
    "@swc/core-darwin-arm64": "1.7.19",
    "@swc/core-linux-x64-gnu": "1.16.1"
  },
  "//overrides": "Force a single graphql version across the monorepo install. Without this, transitive deps (e.g. @types/graphql-upload) keep an older nested graphql alongside the hoisted copy, which breaks TS type portability (TS2742) when building @vendure/core. Mirrors the ^16.14.2 dependency ranges. Relates to #4701.",
  "overrides": {
    "graphql": "^16.14.2"
  },
  "trustedDependencies": [
    "husky",
    "better-sqlite3",
    "re2"
  ],
  "workspaces": [
    "packages/*",
    "packages/cli/e2e/fixtures/ts5-project",
    "scripts/tooling/typescript6"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS",
      "post-commit": "git update-index --again",
      "pre-commit": "NODE_OPTIONS=\"--max-old-space-size=8096\" lint-staged"
    }
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^45.0.0",
    "eslint-plugin-prefer-arrow": "^1.2.3"
  }
}
