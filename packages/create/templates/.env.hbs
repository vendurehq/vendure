APP_ENV=dev
VENDURE_SERVER_PORT={{ port }}
COOKIE_SECRET={{ cookieSecret }}
SUPERADMIN_USERNAME={{{ escapeSingle superadminIdentifier }}}
SUPERADMIN_PASSWORD={{{ escapeSingle superadminPassword }}}
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
{{#if requiresConnection}}
DB_HOST={{ dbHost }}
DB_PORT={{ dbPort }}
DB_NAME={{{ escapeSingle dbName }}}
DB_USERNAME={{{ escapeSingle dbUserName }}}
DB_PASSWORD={{{ escapeSingle dbPassword }}}
{{/if}}
{{#if dbSchema}}
DB_SCHEMA={{ dbSchema }}
{{/if}}
