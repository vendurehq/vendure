{
    "name": "@vendure/cli",
    "version": "3.8.1",
    "description": "A modern, headless ecommerce framework",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vendurehq/vendure.git",
        "directory": "packages/cli"
    },
    "keywords": [
        "vendure",
        "ecommerce",
        "headless",
        "graphql",
        "typescript"
    ],
    "homepage": "https://www.vendure.io",
    "funding": "https://github.com/sponsors/michaelbromley",
    "private": false,
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=22.12.0"
    },
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "rimraf dist && tsc -p ./tsconfig.cli.json && tsx ./build.ts",
        "watch": "tsc -p ./tsconfig.cli.json --watch",
        "ci": "npm run build",
        "test": "vitest --config vitest.config.mts --run",
        "e2e": "cross-env PACKAGE=cli vitest --config ../../e2e-common/vitest.config.mts --run --pool=forks",
        "e2e:watch": "cross-env PACKAGE=cli vitest --config ../../e2e-common/vitest.config.mts"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "vendure": "dist/cli.js"
    },
    "files": [
        "dist/**/*",
        "register.js"
    ],
    "dependencies": {
        "@clack/prompts": "^0.7.0",
        "@vendure/common": "3.8.1",
        "change-case": "^4.1.2",
        "chokidar": "^3.6.0",
        "commander": "^14.0.1",
        "cross-spawn": "^7.0.6",
        "dotenv": "^16.4.5",
        "fs-extra": "^11.2.0",
        "picocolors": "^1.0.0",
        "semver": "^7.7.2",
        "ts-morph": "^21.0.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "7.1.0-beta || ~7.1.0"
    },
    "devDependencies": {
        "@vendure/core": "3.8.1",
        "@vendure/testing": "3.8.1",
        "cross-env": "^7.0.3"
    },
    "peerDependencies": {
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
