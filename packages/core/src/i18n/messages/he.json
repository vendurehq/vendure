            "label": "גרסאות מוצר"
          }
        }
      },
      "free_shipping": {
        "description": "משלוח חינם"
      },
      "buy_x_get_y_free": {
        "description": "קניית X מוצרים וקבלת Y מוצרים בחינם"
      }
    },
    "PromotionCondition": {
      "minimum_order_amount": {
        "description": "אם סכום ההזמנה גדול מ-{ amount }"
      },
      "at_least_n_with_facets": {
        "description": "קניית לפחות { minimum } מוצרים בעלי המאפיינים שצוינו"
      },
      "contains_products": {
        "description": "קניית לפחות { minimum } מהמוצרים שצוינו",
        "args": {
          "productVariantIds": {
            "label": "גרסאות מוצר"
          }
        }
      },
      "customer_group": {
        "description": "הלקוח חבר בקבוצה שצוינה",
        "args": {
          "customerGroupId": {
            "label": "קבוצת לקוחות"
          }
        }
      },
      "buy_x_get_y_free": {
        "description": "קניית X מוצרים וקבלת Y מוצרים בחינם",
        "args": {
          "variantIdsX": {
            "label": "קניית amountX מגרסאות אלה"
          },
          "variantIdsY": {
            "label": "קבלת amountY מגרסאות אלה בחינם"
          }
        }
      }
    },
    "ShippingCalculator": {
      "default-shipping-calculator": {
        "description": "מחשבון משלוח בתעריף אחיד כברירת מחדל",
        "args": {
          "rate": {
            "label": "מחיר המשלוח"
          },
          "includesTax": {
            "label": "המחיר כולל מס",
            "options": {
              "include": {
                "label": "כולל מס"
              },
              "exclude": {
                "label": "אינו כולל מס"
              },
              "auto": {
                "label": "אוטומטי (לפי הערוץ)"
              }
            }
          },
          "taxRate": {
            "label": "שיעור מס"
          }
        }
      }
    },
    "ShippingEligibilityChecker": {
      "default-shipping-eligibility-checker": {
        "description": "בודק זכאות המשלוח כברירת מחדל",
        "args": {
          "orderMinimum": {
            "label": "ערך הזמנה מינימלי",
            "description": "ההזמנה זכאית רק אם סכומה גדול מערך זה או שווה לו"
          }
        }
