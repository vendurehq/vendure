{
  "configurableOperation": {
    "CollectionFilter": {
      "facet-value-filter": {
        "description": "סינון לפי ערכי מאפיינים",
        "args": {
          "facetValueIds": {
            "label": "ערכי מאפיינים"
          },
          "containsAny": {
            "label": "מכיל לפחות אחד",
            "description": "אם מסומן, על גרסאות המוצר להכיל לפחות אחד מערכי המאפיינים שנבחרו. אם אינו מסומן, על הגרסה להכיל את כל הערכים שנבחרו."
          },
          "combineWithAnd": {
            "label": "מצב שילוב",
            "description": "אם מסנן זה משולב עם מסננים אחרים, האם כל התנאים צריכים להתקיים (AND) או שדי באחד מהם (OR)?"
          }
        }
      },
      "variant-name-filter": {
        "description": "סינון לפי שם גרסת המוצר",
        "args": {
          "combineWithAnd": {
            "label": "מצב שילוב",
            "description": "אם מסנן זה משולב עם מסננים אחרים, האם כל התנאים צריכים להתקיים (AND) או שדי באחד מהם (OR)?"
          }
        }
      },
      "variant-id-filter": {
        "description": "בחירה ידנית של גרסאות מוצר",
        "args": {
          "variantIds": {
            "label": "גרסאות מוצר"
          },
          "combineWithAnd": {
            "label": "מצב שילוב",
            "description": "אם מסנן זה משולב עם מסננים אחרים, האם כל התנאים צריכים להתקיים (AND) או שדי באחד מהם (OR)?"
          }
        }
      },
      "product-id-filter": {
        "description": "בחירה ידנית של מוצרים",
        "args": {
          "productIds": {
            "label": "מוצרים"
          },
          "combineWithAnd": {
            "label": "מצב שילוב",
            "description": "אם מסנן זה משולב עם מסננים אחרים, האם כל התנאים צריכים להתקיים (AND) או שדי באחד מהם (OR)?"
          }
        }
      }
    },
    "EntityDuplicator": {
      "product-duplicator": {
        "description": "משכפל ברירת המחדל למוצרים",
        "args": {
          "includeVariants": {
            "label": "כלול גרסאות"
          }
        }
      },
      "collection-duplicator": {
        "description": "משכפל ברירת המחדל לאוספים"
      },
      "facet-duplicator": {
        "description": "משכפל ברירת המחדל למאפיינים",
        "args": {
          "includeFacetValues": {
            "label": "כלול ערכי מאפיינים"
          }
        }
      },
      "promotion-duplicator": {
        "description": "משכפל ברירת המחדל למבצעים"
      }
    },
    "FulfillmentHandler": {
      "manual-fulfillment": {
        "description": "הזנה ידנית של פרטי המשלוח"
      }
    },
    "PaymentMethodHandler": {
      "dummy-payment-handler": {
        "description": "ספק תשלומים מדומה המיועד לבדיקות ולפיתוח בלבד.",
        "args": {
          "automaticSettle": {
            "label": "אישור וסליקה בשלב אחד",
