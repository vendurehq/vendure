{
    "extends": "../../tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "sourceMap": true,
        "jsx": "react-jsx",
        "paths": {
            "@plugins/*": ["./test-plugins/*"]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "**/*.tsx",
        "example-plugins/**/dashboard/**/*",
        "test-plugins/**/components/**/*",
        "test-plugins/**/dashboard/**/*",
        "test-plugins/**/react/**/*"
    ]
}
