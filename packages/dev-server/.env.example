# === 数据库（必填）===
DB=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=vendure

# === API 端口 ===
API_PORT=3000

# === 会话 / CSRF（必填，缺失直接拒绝启动）===
# 会话 Cookie 签名密钥，必须 ≥32 字符；生成：openssl rand -base64 32
COOKIE_SECRET=
# 写操作允许的页面 origin（逗号分隔，大小写不敏感）
# 未设置时用 dev-config.ts 内置默认（生产三站点 + localhost:5280/3000 + 127.0.0.1:3100 + g.joho.cn）；
# 一旦设置则完全覆盖默认，本地联调示例：
# CSRF_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://g.joho.cn

# === 本地首次启动步骤（一次性）===
# 1) 建空库：psql -U postgres -c "CREATE DATABASE vendure"
# 2) 复制本文件为 .env，填好 DB_* 与 COOKIE_SECRET
# 3) 启动：pnpm --filter @vendure/dev-server dev
#    （DB_SYNC 未设为 0 时 synchronize=true，onebridge 8 张表与各插件 customFields 自动建表）
# 4) 需要 ONE BRIDGE 渠道时：node tools/seed-onebridge-channel.mjs

# === ONE BRIDGE 跨境频道 ===
# 渠道 token 由 tools/seed-onebridge-channel.mjs 创建后回写到 tools/onebridge-channel.json，把其中的 token 填这里；
# 未设置时插件按请求 ctx.channel.token 判定（本地多租户共用默认通道时才需要显式绑定）
ONE_BRIDGE_CHANNEL_TOKEN=

# === 短信 / 手机号登录 ===
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# === 微信登录 ===
WECHAT_AUTH_APP_ID=
WECHAT_AUTH_APP_SECRET=
WECHAT_AUTH_MINI_APP_ID=
WECHAT_AUTH_MINI_APP_SECRET=

# === 抖音登录 ===
DOUYIN_AUTH_APP_ID=
DOUYIN_AUTH_APP_SECRET=

# === Redis（可选，用于库存插件）===
REDIS_URL=

# === 快递 100 物流查询（可选）===
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# === 生态行为上报（E5b，可选）===
# 游戏服务器生态事件接口地址与共享密钥（与 game-server 的 ECO_SHARED_SECRET 一致）
GAME_ECO_URL=
GAME_ECO_SECRET=

# === 校园外卖插件：跨实例去重（M5，建议显式声明）===
# memory | db | redis；未设置时 Postgres 默认 db、sqlite/dev 默认 memory
# 多实例（容器多副本 / pm2 cluster）必须为 db 或 redis，否则冷却/限频/去重会失效
CAMPUS_DEDUPE_DRIVER=db
# 部署实例数（扩容时同步修改；>1 且 driver=memory 启动会告警）
CAMPUS_INSTANCE_COUNT=1
# 通知兜底次数阈值（当日兜底次数达到该值才进入每日巡检；默认 20）
CAMPUS_NOTIFY_FALLBACK_ALERT=20

# === 生产环境必须关闭调试旁路 ===
DEV_BYPASS_SMS=false
DEV_BYPASS_WECHAT=false
DEV_BYPASS_ALIPAY=false
DEV_BYPASS_DOUYIN=false
