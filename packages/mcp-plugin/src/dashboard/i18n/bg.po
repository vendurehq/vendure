msgid "Authorize MCP Client"
msgstr "Оторизиране на MCP клиент"

msgid "The grant could not be revoked; it may have already been removed"
msgstr "Разрешението не можа да бъде отменено; възможно е вече да е премахнато"

msgid "Request failed ({0})"
msgstr "Заявката е неуспешна ({0})"

msgid "An application is requesting admin-scoped access to your Vendure MCP server. Vendure cannot verify the application's identity, so decide based on the destination below — not the name it reports."
msgstr "Приложение иска достъп с администраторски права до вашия Vendure MCP сървър. Vendure не може да провери самоличността на приложението, затова решете въз основа на местоназначението по-долу, а не на името, което приложението съобщава."

msgid "Approve only if you recognise and trust this exact destination."
msgstr "Одобрете само ако разпознавате точно това местоназначение и му се доверявате."

msgid "Authorize MCP access"
msgstr "Оторизиране на MCP достъп"

msgid "Plugin"
msgstr "Плъгин"

msgid "Reported by the application (unverified)"
msgstr "Съобщено от приложението (непроверено)"

msgid "The authorization code will be sent to"
msgstr "Кодът за оторизация ще бъде изпратен до"

msgid "Error loading MCP statistics: {0}"
msgstr "Грешка при зареждане на MCP статистиките: {0}"

msgid "Error loading tools: {0}"
msgstr "Грешка при зареждане на инструментите: {0}"

msgid "The request could not be completed"
msgstr "Заявката не можа да бъде изпълнена"

msgid "Active"
msgstr "Активен"

msgid "Revoked"
msgstr "Отменен"

msgid "Expired"
msgstr "Изтекъл"
