msgid "Request failed ({0})"
msgstr "Не вдалося виконати запит ({0})"

msgid "An application is requesting admin-scoped access to your Vendure MCP server. Vendure cannot verify the application's identity, so decide based on the destination below — not the name it reports."
msgstr "Застосунок запитує доступ із правами адміністратора до вашого MCP-сервера Vendure. Vendure не може перевірити справжність застосунку, тому ухвалюйте рішення за вказаною нижче адресою призначення, а не за назвою, яку повідомляє застосунок."

msgid "Approve only if you recognise and trust this exact destination."
msgstr "Схвалюйте лише тоді, коли ви впізнаєте саму цю адресу призначення й довіряєте їй."

msgid "Authorize MCP access"
msgstr "Авторизувати доступ MCP"

msgid "Plugin"
