msgstr "p95 विलम्ब"

msgid "Authorize MCP Client"
msgstr "MCP क्लाइन्टलाई अधिकृत गर्नुहोस्"

msgid "The grant could not be revoked; it may have already been removed"
msgstr "अनुदान रद्द गर्न सकिएन; यो पहिले नै हटाइएको हुन सक्छ"

msgid "Request failed ({0})"
msgstr "अनुरोध असफल भयो ({0})"

msgid "An application is requesting admin-scoped access to your Vendure MCP server. Vendure cannot verify the application's identity, so decide based on the destination below — not the name it reports."
msgstr "एउटा एप्लिकेसनले तपाईंको Vendure MCP सर्भरमा एडमिन-स्तरको पहुँच मागिरहेको छ। Vendure ले एप्लिकेसनको पहिचान प्रमाणित गर्न सक्दैन, त्यसैले एप्लिकेसनले बताएको नामको आधारमा नभई तल देखाइएको गन्तव्यको आधारमा निर्णय गर्नुहोस्।"

msgid "Approve only if you recognise and trust this exact destination."
msgstr "यही ठ्याक्कै गन्तव्य चिन्नुहुन्छ र भरोसा गर्नुहुन्छ भने मात्र स्वीकृत गर्नुहोस्।"

msgid "Authorize MCP access"
msgstr "MCP पहुँच अधिकृत गर्नुहोस्"

msgid "Plugin"
msgstr "प्लगइन"

msgid "Reported by the application (unverified)"
msgstr "एप्लिकेसनले बताएको (अप्रमाणित)"

msgid "The authorization code will be sent to"
msgstr "प्राधिकरण कोड यहाँ पठाइनेछ"

