{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "master",
    "neverConnectToCloud": true,
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": false
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": ["{workspaceRoot}/tsconfig.json", "{workspaceRoot}/bunfig.toml"],
        "production": [
            "default",
            "!{projectRoot}/**/*.spec.ts",
            "!{projectRoot}/**/*.spec.tsx",
            "!{projectRoot}/**/*.e2e-spec.ts",
            "!{projectRoot}/e2e/**/*",
            "!{projectRoot}/**/vitest.config.mts"
        ]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"],
            "outputs": [
                "{projectRoot}/lib",
                "{projectRoot}/dist",
                "{projectRoot}/dist-plugin",
                "{projectRoot}/package",
                "{projectRoot}/cli",
                "{projectRoot}/assets"
            ],
            "cache": true
        },
        "ci": {
            "dependsOn": ["^ci"],
            "inputs": ["production", "^production"],
            "outputs": [
                "{projectRoot}/lib",
                "{projectRoot}/dist",
                "{projectRoot}/dist-plugin",
                "{projectRoot}/package",
                "{projectRoot}/cli",
                "{projectRoot}/assets"
            ],
            "cache": true
        },
        "test": {
            "dependsOn": [
                "^ci",
                {
                    "projects": ["@vendure/testing"],
                    "target": "ci"
                }
            ],
            "inputs": ["default", "^production", "{workspaceRoot}/vitest.shared.mts"]
        },
        "e2e": {
            "dependsOn": [
                "^ci",
                {
                    "projects": ["@vendure/testing"],
                    "target": "ci"
                }
            ],
            "inputs": ["default", "^production", "{workspaceRoot}/e2e-common/**/*"]
        },
        "watch": {
            "continuous": true
        }
    },
    "release": {
        "projects": ["packages/*"],
        "projectsRelationship": "fixed",
        "releaseTag": {
            "pattern": "v{version}"
        },
        "version": {
            "currentVersionResolver": "disk",
            "versionPrefix": "",
            "preserveMatchingDependencyRanges": false,
            "preserveLocalDependencyProtocols": false,
            "versionActionsOptions": {
                "skipLockFileUpdate": true
            }
        },
        "changelog": {
            "workspaceChangelog": false,
            "projectChangelogs": false
        }
    }
}
